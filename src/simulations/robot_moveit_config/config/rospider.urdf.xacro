<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rospider">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rospider urdf file -->
    <xacro:include filename="$(find rospider_description)/urdf/rospider.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="rospider.ros2_control.xacro" />


    <xacro:rospider_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
