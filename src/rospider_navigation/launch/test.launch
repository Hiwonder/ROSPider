<?xml version="1.0"?>
<launch>
	<arg name="master_name" default="$(env MASTER_NAME)"/>
	<arg name="robot_name" default="$(env ROBOT_NAME)" />
	<arg name="tf_prefix" default="$(arg robot_name)" />

	<arg name="map_topic" default="/$(arg master_name)/map"/>
	<arg name="map_frame_id" default="$(arg master_name)/map"/>

	<arg name="use_depth_camera" default="false"/>
	<arg name="odom_topic" default="odom/filtered"/> # odom话题
	<arg name="scan_topic" default="scan_filtered" /> # 雷达话题
	<arg name="cmd_vel_topic" default="rospider_controller/cmd_vel"/>
	<arg name="odom_frame_id" default="$(arg tf_prefix)/odom"/>
	<arg name="base_frame_id" default="$(arg tf_prefix)/base_link"/>
	<arg name="move_base_result" default="move_base/result" />
	<arg name="clicked_point" default="clicked_point" />

	<group ns="$(arg robot_name)">
		<!-- 机器人的URDF描述 -->
		<include file="$(find rospider_description)/launch/description.launch">
			<arg name="robot_name" value="$(arg robot_name)" />
			<arg name="tf_prefix" value="$(arg tf_prefix)" />
		</include>

		<!-- 激光雷达 -->
		<include unless="$(arg use_depth_camera)" file="$(find rospider_peripherals)/launch/lidar.launch">
			<arg name="tf_prefix" value="$(arg tf_prefix)" />
			<arg name="scan_topic" value="scan" />
		</include>

    		<include file="$(find rospider_peripherals)/launch/lidar_filter.launch">
        		<arg name="scan_raw" value="scan" />
        		<arg name="scan_topic" value="$(arg scan_topic)" />
    		</include>

		<!-- 机体运动控制 -->
		<include file="$(find rospider_controller)/launch/rospider_controller.launch">
			<arg name="robot_name" value="$(arg robot_name)" />
			<arg name="tf_prefix" value="$(arg tf_prefix)" />
			<arg name="tf_enable" value="false" />
			<arg name="odom_enable" value="true" />
		</include>

		<!-- 手柄遥控 -->
		<include file="$(find rospider_peripherals)/launch/joystick_control.launch" />

		<!-- 姿态传感器 -->
		<include file="$(find rospider_peripherals)/launch/imu.launch">
			<arg name="tf_prefix" value="$(arg tf_prefix)" />
			<arg name="freq" value="50" />
		</include>

		<!-- 激光雷达模拟里程计 -->
		<include file="$(find rospider_slam)/launch/include/rf2o_laser_odometry.launch">
			<arg name="scan_topic" value="scan" />
			<arg name="odom_topic" value="odom/laser" />
			<arg name="odom_frame_id" value="$(arg odom_frame_id)" />
			<arg name="base_frame_id" value="$(arg base_frame_id)" />
			<arg name="laser_frame_id" value="$(arg tf_prefix)/laser_link" />
		</include>

		<!-- 里程计滤波融合 -->
		<include file="$(find rospider_slam)/launch/include/rospider_ekf.launch">
			<arg name="tf_prefix" value="$(arg tf_prefix)" />
			<arg name="robot_name" value="$(arg robot_name)" />
		</include>
	</group>
</launch>
