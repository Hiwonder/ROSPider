<?xml version="1.0" encoding="ASCII" ?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- parameters -->
    <xacro:property name="my_pi" value="3.1415926535897931"/>
    <xacro:property name="coxa_z"        value="0.02190000000"/>
    <xacro:property name="coxa_length"   value="0.04455000"/>
    <xacro:property name="femur_length"  value="0.07516779190"/>
    <xacro:property name="tibia_length"  value="0.12913312503"/>

    <!-- Joint properties -->
    <xacro:property name="joint_lower_limit" value="-${3.14}" />
    <xacro:property name="joint_upper_limit" value="${3.14}" />
    <xacro:property name="joint_effort" value="6.0" />
    <xacro:property name="joint_velocity" value="0.524" />

    <!-- Leg macro -->
    <xacro:macro name="leg" params="prefix side position x y angle axis">
        <!-- leg position -->
	<!--
        <joint name="${prefix}leg_center_joint_${side}${position}" type="fixed">
            <origin xyz="${x} ${y} 0.0" rpy="0.0 0.0 0.0" />
            <parent link="${prefix}body_link" />
            <child link="${prefix}leg_center_${side}${position}" />
        </joint>
        <link name="${prefix}leg_center_${side}${position}">
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <mass value="0.00001"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
            </inertial>
        </link>
	-->
        <!-- coxa -->
        <joint name="${prefix}coxa_joint_${side}${position}" type="revolute">
	    <origin xyz="${x} ${y} ${coxa_z}" rpy="0.0 0.0 ${angle}" />
            <parent link="${prefix}body_link" />
            <child link="${prefix}coxa_${side}${position}" />
            <axis xyz="0.0 0.0 1.0" />
            <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="${joint_effort}" velocity="${joint_velocity}" />
	    <dynamics damping="0.7" />
        </joint>
        <link name="${prefix}coxa_${side}${position}">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
			<mesh filename="package://rospider_description/meshes/coxa_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
                <material name="">
                    <color rgba="0.4 0.4 0.4 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <geometry>
			<mesh filename="package://rospider_description/meshes/coxa_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <mass value="0.00001"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
            </inertial>
        </link>
        <!-- femur -->
        <joint name="${prefix}femur_joint_${side}${position}" type="revolute">
		<origin xyz="${coxa_length} 0.0 0.0" rpy="${axis*my_pi/2} 0.0 0.0" />
            <parent link="${prefix}coxa_${side}${position}" />
            <child link="${prefix}femur_${side}${position}" />
            <axis xyz="0.0 0.0 ${axis}" />
            <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="${joint_effort}" velocity="${joint_velocity}" />
	    <dynamics damping="0.7" />
        </joint>
        <link name="${prefix}femur_${side}${position}">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
			<mesh filename="package://rospider_description/meshes/femur_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
                <material name="">
                    <color rgba="0.2 0.2 0.2 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0" />
                <geometry>
			<mesh filename="package://rospider_description/meshes/femur_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
                <material name="">
                    <color rgba="0.2 0.2 0.2 1" />
                </material>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 1.0" />
                <mass value="0.00001"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
            </inertial>
        </link>

        <!-- tibia -->
        <joint name="${prefix}tibia_joint_${side}${position}" type="revolute">
	    <origin xyz="${femur_length} 0.0 0.0" rpy="0.0 0.0 ${-axis*(my_pi/2)}" /> 
		<!-- +0.284402624215617 -->
            <parent link="${prefix}femur_${side}${position}" />
            <child link="${prefix}tibia_${side}${position}" />
            <axis xyz="0.0 0.0 ${axis}" />
            <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}" effort="${joint_effort}" velocity="${joint_velocity}" />
	    <dynamics damping="0.7" />
        </joint>
        <link name="${prefix}tibia_${side}${position}">
            <visual>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
			<mesh filename="package://rospider_description/meshes/tibia_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
                <material name="">
                    <color rgba="0.5 0.5 0.5 1" />
                </material>
            </visual>
            <collision>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
			<mesh filename="package://rospider_description/meshes/tibia_${side}.stl" scale="1.0 1.0 1.0"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <mass value="0.00001"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
            </inertial>
        </link>

        <!-- ENDPOINT -->
        <joint name="${prefix}end_joint${side}${position}" type="fixed">
	    <origin xyz="${tibia_length} 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="${prefix}tibia_${side}${position}" />
            <child link="${prefix}endpoint_${side}${position}" />
            <axis xyz="0.0 0.0 0.0" />
        </joint>
        <link name="${prefix}endpoint_${side}${position}">
        </link>
    </xacro:macro>

    <xacro:macro name="rospider" params="prefix parent *origin">
        <joint name="${prefix}base_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${prefix}body_link" />
            <xacro:insert_block name="origin"/>
        </joint>
        <link name="${prefix}body_link">
            <visual>
	        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <geometry>
			<mesh filename="package://rospider_description/meshes/body.stl" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="0.2 0.2 0.2 1" />
                </material>
            </visual>
            <collision>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry>
			<mesh filename="package://rospider_description/meshes/body.stl" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <mass value="0.00001"/>
                <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
            </inertial>
        </link>
	<joint name="${prefix}lidar_base_joint" type="fixed">
            <parent link="${prefix}body_link"/>
            <child link="${prefix}lidar_base_link"/>
            <origin xyz="0.07970422634 0.00180336342 0.05389289402" rpy="0.0 0.0 0.0"/>
        </joint>

	<link name="${prefix}lidar_base_link">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://rospider_description/meshes/lidar_a2.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<material name="">
                    		<color rgba="0.2 0.2 0.2 1" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://rospider_description/meshes/lidar_a2.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<material name="">
                    		<color rgba="0.2 0.2 0.2 1" />
			</material>
		</collision>
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<mass value="0.00001"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
		</inertial>
	</link>

        <!-- Depth camera properties -->
        <joint name="${prefix}camera_base_joint" type="revolute">
            <parent link="${prefix}body_link"/>
            <child link="${prefix}camera_base_link"/>
            <origin xyz="0.01637579035 0.00180788035 0.11927289569" rpy="0.0 0.0 0.0"/>
            <limit lower="-2.1" upper="2.1" effort="${joint_effort}" velocity="${joint_velocity}" />
            <axis xyz="0.0 0.0 1.0" />
        </joint>
        <link name="${prefix}camera_base_link">
		<visual>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://rospider_description/meshes/astrapro.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<material name="">
				<color rgba="0.3 0.3 0.3 1" />
			</material>
		</visual>
		<collision>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<geometry>
				<mesh filename="package://rospider_description/meshes/astrapro.stl" scale="1.0 1.0 1.0"/>
			</geometry>
			<material name="">
				<color rgba="0.3 0.3 0.3 1"/>
			</material>
		</collision>
		<inertial>
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
			<mass value="0.00001"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
		</inertial>
	</link>


	<xacro:leg prefix="${prefix}" side="R" position="F" x="0.152747935790" y="-0.09349910970" angle="${-46.64489909/180*my_pi}"      axis="-1" />
	<xacro:leg prefix="${prefix}" side="R" position="M" x="-0.00029797781" y="-0.11415782485" angle="${-my_pi/2}"                    axis="-1" />
	<xacro:leg prefix="${prefix}" side="R" position="R" x="-0.15274793579" y="-0.09349910970" angle="${46.64489909/180*my_pi+my_pi}" axis="-1" />

	<xacro:leg prefix="${prefix}" side="L" position="F" x="0.152747937160" y="0.097105835240" angle="${46.64489909/180*my_pi}"       axis="1"/>
	<xacro:leg prefix="${prefix}" side="L" position="M" x="-0.00029797781" y="0.117764551690" angle="${my_pi/2}"                     axis="1"/>
	<xacro:leg prefix="${prefix}" side="L" position="R" x="-0.15334332732" y="0.097105835240" angle="${-46.64489909/180*my_pi-my_pi}"       axis="1"/>
    </xacro:macro>
</robot>
