<launch>
	<arg name="color" default="red"/>

	<include file="$(find rospider_peripherals)/launch/camera.launch"></include>
	<include file="$(find lab_config)/launch/lab_config_manager.launch"></include>

	<node name="face_tracking_node" pkg="rospider_tutorial" type="ros_ai_creative_pilot_01_line_find.py" args="$(arg color)" output="screen">
	</node>
</launch>
