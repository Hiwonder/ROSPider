<launch>
    <arg name="tf_prefix" default="" />
    <arg name="robot_name" default="rospider" />

    <!-- 机器人的URDF描述 -->
    <include file="$(find rospider_description)/launch/description.launch">
        <arg name="tf_prefix" value="$(arg tf_prefix)" />
    </include>

    <!-- 机体运动控制 -->
    <include file="$(find rospider_controller)/launch/rospider_controller_ros_app.launch">
	<arg name="odom_enable" value="false" />
	<arg name="tf_enable" value="false" />
    </include>

    <!-- 激光雷达 -->
    <include file="$(find rospider_peripherals)/launch/lidar.launch">
        <arg name="tf_prefix" value="$(arg tf_prefix)" />
        <arg name="scan_topic" value="/scan_raw" />
	<arg name="scan_frequency" value="40" />
    </include>
    <include file="$(find rospider_peripherals)/launch/lidar_filter.launch">
        <arg name="scan_raw" value="/scan_raw" />
        <arg name="scan_topic" value="/scan" />
	<arg name="base_frame" value="laser_link" />
    </include>
    <include file="$(find rospider_peripherals)/launch/lidar_filter2.launch">
        <arg name="scan_raw" value="/scan_raw" />
        <arg name="scan_topic" value="/scan_2" />
	<arg name="base_frame" value="laser_link" />
    </include>

    <!-- 姿态传感器 -->
    <include file="$(find rospider_peripherals)/launch/imu.launch">
        <arg name="tf_prefix" value="$(arg tf_prefix)" />
        <arg name="freq" value="100" />
    </include>

    <!-- 相机 -->
    <include file="$(find rospider_peripherals)/launch/usb_cam.launch">
    </include>

    <!-- 激光雷达模拟里程计 -->
    <include file="$(find rospider_slam)/launch/include/rf2o_laser_odometry.launch">
            <arg name="scan_topic" value="/scan_2" />
            <arg name="odom_topic" value="odom" />
            <arg name="odom_frame_id" value="odom" />
            <arg name="base_frame_id" value="base_link" />
            <arg name="laser_frame_id" value="laser_link" />
	    <arg name="publish_tf" value="true" />
    </include>

    <!-- 里程计滤波融合 -->
    <!--
    <include file="$(find rospider_slam)/launch/include/rospider_ekf.launch">
        <arg name="tf_prefix" value="$(arg tf_prefix)" />
        <arg name="robot_name" value="$(arg robot_name)" />
	<arg name="odom_topic" value="/odom" />
	<arg name="cmd_vel_topic" value="/cmd_vel" />
    </include>
   -->
</launch>
