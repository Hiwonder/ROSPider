<launch>
  <arg name="tf_prefix" default="" />
  <arg name="camera_type" default="$(optenv CAMERA_TYPE DABAI)"/> # 相机型号
  <param name="camera_type" value="$(arg camera_type)" />

  <!-- 使用 DABAI 相机 -->
  <group if="$(eval arg('camera_type')=='DABAI')">
    <param name="camera_type" value="$(arg camera_type)" />
    <param name="camera_rgb_prefix" value="camera/rgb" />
    <include file="$(find rospider_peripherals)/launch/include/Halley_ros_app.launch">
	<arg name="tf_prefix" value="$(arg tf_prefix)" />
    </include>
  </group>

  <group if="$(eval arg('camera_type')=='AstraPro')">
    <param name="camera_type" value="$(arg camera_type)" />
    <param name="camera_rgb_prefix" value="camera/rgb" />
    <include file="$(find rospider_peripherals)/launch/include/astrapro_ros_app.launch">
	<arg name="tf_prefix" value="$(arg tf_prefix)" />
    </include>
  </group>


  <!-- 使用 CSI 相机 -->
  <group if="$(eval arg('camera_type')=='CSI')">
    <param name="camera_rgb_prefix" value="csi_camera" />
    <include file="$(find rospider_peripherals)/launch/include/csi_camera_ros_app.launch">
    </include>
  </group>


  <!-- web video 流 -->
  <node name="web_video_server" pkg="web_video_server" type="web_video_server">
    <param name="type" value="h264" />
  </node>

</launch>
