<launch>
  <arg name="scan_raw" default="scan" />
  <arg name="scan_topic" default="scan_filtered" />
  <arg name="base_frame" default="lidar_link" />

  <!--雷达过滤-->
  <node pkg="laser_filters" type="scan_to_scan_filter_chain" output="screen" name="laser_filter_1">
    <rosparam ns="scan_filter_chain" subst_value="true">

    - name: range_filter
      type: laser_filters/LaserScanRangeFilter
      params:
        use_message_range_limits: false
        lower_threshold: 0.24
        upper_threshold: .inf
        lower_replacement_value: -.inf
        upper_replacement_value: .inf

    - name: box_filter
      type: laser_filters/LaserScanBoxFilter
      params:
          box_frame: $(arg base_frame)
          min_x: -0.20
          max_x: 1.00
          min_y: -0.30
          max_y: 0.30
          min_z: -0.2
          max_z: 0.2

    - name: angle_filter
      type: laser_filters/LaserScanAngularBoundsFilterInPlace
      params:
          lower_angle: -1.6
          upper_angle: 1.6

    - name: speckle_filter
      type: laser_filters/LaserScanSpeckleFilter
      params:
        filter_type: 0
        max_range: 2.0
        max_range_difference: 0.05
        filter_window: 30
    
    </rosparam>
    <remap from="scan" to="$(arg scan_raw)" />
    <remap from="scan_filtered" to="$(arg scan_topic)" />

  </node>
</launch>
